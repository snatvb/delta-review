    "@types/node": "^26.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
